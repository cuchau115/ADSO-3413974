    <bpmn:sequenceFlow id="F6" name="No" sourceRef="G1" targetRef="T5" />
    <bpmn:sequenceFlow id="F7" sourceRef="T4" targetRef="S1" />
    <bpmn:sequenceFlow id="F8" sourceRef="S1" targetRef="G2" />
    <bpmn:sequenceFlow id="F9" name="No" sourceRef="G2" targetRef="T4" />
    <bpmn:sequenceFlow id="F10" name="Sí" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F11" sourceRef="T5" targetRef="G3" />
    <bpmn:sequenceFlow id="F12" name="Sí" sourceRef="G3" targetRef="T6" />
    <bpmn:sequenceFlow id="F13" name="No" sourceRef="G3" targetRef="EE" />
    <bpmn:sequenceFlow id="F14" sourceRef="T6" targetRef="S2" />
    <bpmn:sequenceFlow id="F15" sourceRef="S2" targetRef="EE" />

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_1" name="Gestion de Horarios" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_U" name="Usuario">
        <bpmn:flowNodeRef>SE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_S" name="Sistema">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SE" name="Acceso al sistema">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="U1" name="Ingresar credenciales">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="U2" name="Consultar panel de notificaciones y estados globales">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EE" name="Sesión iniciada">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="U3" name="Solicitar recuperación de contraseña">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="U4" name="Crear nueva contraseña">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S1" name="Validar credenciales">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="¿Credenciales válidas?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S2" name="Cargar App Shell según rol">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="¿Recuperar contraseña?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S3" name="Enviar enlace de recuperación">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S4" name="Actualizar credencial">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F1" sourceRef="SE" targetRef="U1" />
    <bpmn:sequenceFlow id="F2" sourceRef="U1" targetRef="S1" />
    <bpmn:sequenceFlow id="F3" sourceRef="S1" targetRef="G1" />
    <bpmn:sequenceFlow id="F4" name="Sí" sourceRef="G1" targetRef="S2" />
    <bpmn:sequenceFlow id="F5" sourceRef="S2" targetRef="U2" />
    <bpmn:sequenceFlow id="F6" sourceRef="U2" targetRef="EE" />
    <bpmn:sequenceFlow id="F7" name="No" sourceRef="G1" targetRef="G2" />
    <bpmn:sequenceFlow id="F8" name="Sí" sourceRef="G2" targetRef="U3" />
    <bpmn:sequenceFlow id="F9" sourceRef="U3" targetRef="S3" />
    <bpmn:sequenceFlow id="F10" sourceRef="S3" targetRef="U4" />
    <bpmn:sequenceFlow id="F11" sourceRef="U4" targetRef="S4" />
    <bpmn:sequenceFlow id="F12" sourceRef="S4" targetRef="U1" />
    <bpmn:sequenceFlow id="F13" name="No" sourceRef="G2" targetRef="U1" />
  </bpmn:process>

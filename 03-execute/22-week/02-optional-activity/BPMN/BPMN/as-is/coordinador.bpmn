<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Coordinador" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collab_Coordinador">
    <bpmn:participant id="Participant_Coordinador" name="Gestion de Horarios" processRef="Process_Coordinador" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Coordinador" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Coordinador">
      <bpmn:lane id="Lane_Sistema" name="Sistema">
        <bpmn:flowNodeRef>Task_DetectarConflictos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Conflictos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PanelConflictos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublicarHorario</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinador" name="Coordinador">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dashboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_HorarioExiste</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CrearBorrador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AbrirHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sesiones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Disponibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Ambientes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmarPublicacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsultarFichas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Credenciales válidas">
      <bpmn:outgoing>Flow_Start_Dash</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Dashboard" name="Revisar dashboard (estado general)">
      <bpmn:incoming>Flow_Start_Dash</bpmn:incoming>
      <bpmn:outgoing>Flow_Dash_GWExiste</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_HorarioExiste" name="¿El horario ya existe?">
      <bpmn:incoming>Flow_Dash_GWExiste</bpmn:incoming>
      <bpmn:outgoing>Flow_GWExiste_Crear</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWExiste_Abrir</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CrearBorrador" name="Crear borrador de horario">
      <bpmn:incoming>Flow_GWExiste_Crear</bpmn:incoming>
      <bpmn:outgoing>Flow_Crear_Sesiones</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AbrirHorario" name="Abrir horario en edición">
      <bpmn:incoming>Flow_GWExiste_Abrir</bpmn:incoming>
      <bpmn:outgoing>Flow_Abrir_Sesiones</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Sesiones" name="Agregar / editar sesiones">
      <bpmn:incoming>Flow_Crear_Sesiones</bpmn:incoming>
      <bpmn:incoming>Flow_Abrir_Sesiones</bpmn:incoming>
      <bpmn:incoming>Flow_Panel_Sesiones</bpmn:incoming>
      <bpmn:incoming>Flow_GWAmb_Sesiones</bpmn:incoming>
      <bpmn:outgoing>Flow_Sesiones_Detectar</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutAssoc_Borrador">
        <bpmn:targetRef>DataObjectReference_Borrador</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_Disponibilidad" name="Consultar disponibilidad de ambientes">
      <bpmn:incoming>Flow_GWConf_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Disp_GWAmb</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Ambientes" name="¿Disponibilidad correcta?">
      <bpmn:incoming>Flow_Disp_GWAmb</bpmn:incoming>
      <bpmn:outgoing>Flow_GWAmb_Confirmar</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWAmb_Sesiones</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConfirmarPublicacion" name="Confirmar publicación">
      <bpmn:incoming>Flow_GWAmb_Confirmar</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmar_Publicar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConsultarFichas" name="Consultar fichas e información relacionada">
      <bpmn:incoming>Flow_Publicar_Fichas</bpmn:incoming>
      <bpmn:outgoing>Flow_Fichas_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Horario publicado">
      <bpmn:incoming>Flow_Fichas_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_DetectarConflictos" name="Detectar conflictos">
      <bpmn:incoming>Flow_Sesiones_Detectar</bpmn:incoming>
      <bpmn:outgoing>Flow_Detectar_GWConf</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Conflictos" name="¿Existen conflictos?">
      <bpmn:incoming>Flow_Detectar_GWConf</bpmn:incoming>
      <bpmn:outgoing>Flow_GWConf_Panel</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWConf_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PanelConflictos" name="Mostrar panel de conflictos">
      <bpmn:incoming>Flow_GWConf_Panel</bpmn:incoming>
      <bpmn:outgoing>Flow_Panel_Sesiones</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PublicarHorario" name="Publicar horario">
      <bpmn:incoming>Flow_Confirmar_Publicar</bpmn:incoming>
      <bpmn:outgoing>Flow_Publicar_Fichas</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutAssoc_Publicado">
        <bpmn:targetRef>DataObjectReference_Publicado</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="DataObjectReference_Borrador" name="Borrador de horario" dataObjectRef="DataObject_Borrador" />
    <bpmn:dataObject id="DataObject_Borrador" />
    <bpmn:dataObjectReference id="DataObjectReference_Publicado" name="Horario publicado" dataObjectRef="DataObject_Publicado" />
    <bpmn:dataObject id="DataObject_Publicado" />
    <bpmn:sequenceFlow id="Flow_Start_Dash" sourceRef="StartEvent_1" targetRef="Task_Dashboard" />
    <bpmn:sequenceFlow id="Flow_Dash_GWExiste" sourceRef="Task_Dashboard" targetRef="GW_HorarioExiste" />
    <bpmn:sequenceFlow id="Flow_GWExiste_Crear" name="No" sourceRef="GW_HorarioExiste" targetRef="Task_CrearBorrador" />
    <bpmn:sequenceFlow id="Flow_GWExiste_Abrir" name="Sí" sourceRef="GW_HorarioExiste" targetRef="Task_AbrirHorario" />
    <bpmn:sequenceFlow id="Flow_Crear_Sesiones" sourceRef="Task_CrearBorrador" targetRef="Task_Sesiones" />
    <bpmn:sequenceFlow id="Flow_Abrir_Sesiones" sourceRef="Task_AbrirHorario" targetRef="Task_Sesiones" />
    <bpmn:sequenceFlow id="Flow_Panel_Sesiones" sourceRef="Task_PanelConflictos" targetRef="Task_Sesiones" />
    <bpmn:sequenceFlow id="Flow_GWAmb_Sesiones" name="No, ajustar sesiones" sourceRef="GW_Ambientes" targetRef="Task_Sesiones" />
    <bpmn:sequenceFlow id="Flow_Sesiones_Detectar" sourceRef="Task_Sesiones" targetRef="Task_DetectarConflictos" />
    <bpmn:sequenceFlow id="Flow_GWConf_No" name="No" sourceRef="GW_Conflictos" targetRef="Task_Disponibilidad" />
    <bpmn:sequenceFlow id="Flow_Disp_GWAmb" sourceRef="Task_Disponibilidad" targetRef="GW_Ambientes" />
    <bpmn:sequenceFlow id="Flow_GWAmb_Confirmar" name="Sí" sourceRef="GW_Ambientes" targetRef="Task_ConfirmarPublicacion" />
    <bpmn:sequenceFlow id="Flow_Confirmar_Publicar" sourceRef="Task_ConfirmarPublicacion" targetRef="Task_PublicarHorario" />
    <bpmn:sequenceFlow id="Flow_Publicar_Fichas" sourceRef="Task_PublicarHorario" targetRef="Task_ConsultarFichas" />
    <bpmn:sequenceFlow id="Flow_Fichas_End" sourceRef="Task_ConsultarFichas" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_Detectar_GWConf" sourceRef="Task_DetectarConflictos" targetRef="GW_Conflictos" />
    <bpmn:sequenceFlow id="Flow_GWConf_Panel" name="Sí" sourceRef="GW_Conflictos" targetRef="Task_PanelConflictos" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_Coordinador">
      <bpmndi:BPMNShape id="Participant_Coordinador_di" bpmnElement="Participant_Coordinador" isHorizontal="true">
        <dc:Bounds x="145" y="80" width="1900" height="560" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
